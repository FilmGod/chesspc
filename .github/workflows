name: Build APK
on:
  workflow_dispatch:
  push:
    branches: [main, master]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Unzip project
        run: unzip -q ChessLens.zip
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - name: Accept Android licenses
        run: yes | "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" --licenses || true
      - name: Build Stockfish from source (optional)
        continue-on-error: true
        working-directory: ChessLens
        run: |
          set -x
          NDK="${ANDROID_NDK_HOME:-$ANDROID_NDK_ROOT}"
          if [ -z "$NDK" ] || [ ! -d "$NDK" ]; then
            NDK=$(ls -d "$ANDROID_HOME"/ndk/* 2>/dev/null | sort -V | tail -n 1)
          fi
          echo "NDK: $NDK"
          test -d "$NDK"
          BINDIR="$NDK/toolchains/llvm/prebuilt/linux-x86_64/bin"
          ls "$BINDIR" | grep 'aarch64-linux-android.*clang++' || true
          export PATH="$BINDIR:$PATH"
          git clone --depth 1 --branch sf_19 https://github.com/official-stockfish/Stockfish.git sf || git clone --depth 1 https://github.com/official-stockfish/Stockfish.git sf
          cd sf/src
          if ! make -j4 build ARCH=armv8 COMP=ndk; then
            make clean || true
            CXXNAME=$(ls "$BINDIR" | grep -E '^aarch64-linux-android[0-9]+-clang\+\+$' | sort -V | tail -n 1)
            make -j4 build ARCH=armv8 COMP=clang CXX="$CXXNAME"
          fi
          test -s stockfish
          file stockfish || true
          mkdir -p ../../app/src/main/jniLibs/arm64-v8a
          cp stockfish ../../app/src/main/jniLibs/arm64-v8a/libstockfish.so
          ls -la ../../app/src/main/jniLibs/arm64-v8a/
      - name: Build debug APK
        working-directory: ChessLens
        run: |
          chmod +x gradlew
          ./gradlew --no-daemon assembleDebug
      - uses: actions/upload-artifact@v4
        with:
          name: ChessLens-apk
          path: ChessLens/app/build/outputs/apk/debug/app-debug.apk
  build-pc:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - name: Unzip project
        shell: pwsh
        run: Expand-Archive -Path ChessLens.zip -DestinationPath . -Force
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - name: Build PC jar
        shell: pwsh
        working-directory: ChessLens
        run: ./gradlew.bat --no-daemon -p pc jar
      - name: Download Stockfish for Windows (optional)
        continue-on-error: true
        shell: pwsh
        working-directory: ChessLens
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          New-Item -ItemType Directory -Force -Path sfdl | Out-Null
          gh release download --repo official-stockfish/Stockfish --pattern "stockfish-windows-x86-64-sse41-popcnt.zip" --dir sfdl
          Expand-Archive -Path sfdl/*.zip -DestinationPath sfdl/x -Force
          $exe = Get-ChildItem -Path sfdl/x -Recurse -Filter "stockfish*.exe" | Select-Object -First 1
          Copy-Item $exe.FullName sfdl/stockfish.exe
          Get-ChildItem sfdl
      - name: Package Windows app
        shell: pwsh
        working-directory: ChessLens
        run: |
          jpackage --type app-image --name ChessLens --input pc/build/libs --main-jar chesslens.jar --main-class com.chesslens.pc.MainKt --dest dist --java-options "-Dfile.encoding=UTF-8"
          if (Test-Path sfdl/stockfish.exe) { Copy-Item sfdl/stockfish.exe dist/ChessLens/stockfish.exe }
          Compress-Archive -Path dist/ChessLens -DestinationPath ChessLens-Windows.zip
      - uses: actions/upload-artifact@v4
        with:
          name: ChessLens-Windows
          path: ChessLens/ChessLens-Windows.zip
